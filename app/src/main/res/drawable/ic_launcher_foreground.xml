    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Left page -->
    <path
        android:fillColor="#F5EBDD"
        android:pathData="M512,400 C440,350 340,340 262,360 L262,690 C340,670 440,680 512,730 Z" />
    <!-- Right page, slightly shaded -->
