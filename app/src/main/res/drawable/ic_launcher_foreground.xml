        android:strokeColor="#1E1B4B"
        android:strokeWidth="10"
        android:pathData="M512,400 L512,730" />
    <!-- Text lines -->
    <path
        android:strokeColor="#C9B89E"
        android:strokeWidth="16"
        android:strokeLineCap="round"
        android:pathData="M330,450 C380,440 430,445 470,465 M330,520 C380,510 430,515 470,535 M330,590 C380,580 430,585 470,605" />
    <!-- Spark -->
    <path
        android:fillColor="#E8A33D"
        android:pathData="M660,250 L680,305 L735,325 L680,345 L660,400 L640,345 L585,325 L640,305 Z" />
</vector>
